DISCORD_TOKEN=your_discord_bot_token_here
# Optional: Set this to develop commands in a specific guild for faster sync
# DISCORD_GUILD_ID=123456789
# WASH Crew and Watch Party member roles are configured per-server through
# the Setup Wizard (/setup), not through environment variables. Every
# permission check resolves those roles fresh from that server's own
# configuration, so a role set here would never apply.
# Optional: Default number of nominees /start_vote selects when
# nominee_count isn't explicitly given and no guild voting default has
# been set via /setup or /config. Must be between 2 and 10. Defaults to
# 3 if unset.
# DEFAULT_VOTE_NOMINEE_COUNT=3

# OMDb API key used to resolve IMDb title links
OMDB_API_KEY=
